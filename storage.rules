rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Default: locked down to admins.
    // NOTE: product-imagery hosting decision still pending (Cloudinary vs
    // Firebase Storage). If Storage is adopted for product images, open
    // /products/** to public read here.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
