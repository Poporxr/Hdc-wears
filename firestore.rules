// HDC Wears — Firestore security rules (production mode).
// Catalog + gallery are public; everything else is scoped to the owner or an admin.
// Admins are managed via the `admins` collection (doc id = uid); the first admin
// doc must be created manually in the Firebase console, after which that admin
// can grant others.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == "poporxr@gmail.com" ||
         request.auth.token.email == "isaacfewz@gmail.com" ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Storefront catalog — public read, admins only write.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // HDC WORLD photoshoot strip + /gallery page — public read, admins only write.
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer profiles — the owner, or admins for the /admin dashboard.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Per-user cart — synced server-side once login is real.
    match /carts/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Per-user wishlist.
    match /wishlists/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Orders — customers create (pending only) and read their own.
    // All state changes happen server-side via the Paystack webhook/verify
    // (service account). Admins manage everything.
    match /orders/{orderId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending";
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Custom design requests — signed-in users can file; admins triage.
    match /design_requests/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Admin roster — only existing admins can change it.
    // Seed the FIRST admin doc by hand in the Firebase console.
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
